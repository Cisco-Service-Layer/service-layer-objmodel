"""
Service Layer Go Protobuf Bindings

Generated Go code from Service Layer proto files.
Packaged as a proper go_library for consumption by XR build system.
"""

load("@rules_go//go:def.bzl", "go_library")

# Main Go library containing all generated protobuf bindings
go_library(
    name = "slpb",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    importpath = "github.com/Cisco-Service-Layer/service-layer-objmodel/grpc/go/src/gengo",
    visibility = ["//visibility:public"],
    # Runtime dependencies are automatically resolved from go.mod via gazelle
)

# Export go.mod for dependency information
exports_files(
    ["go.mod", "go.sum"],
    visibility = ["//visibility:public"],
)

