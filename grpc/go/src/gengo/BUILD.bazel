"""
Service Layer Go Protobuf Bindings

Generated Go code from Service Layer proto files.
Exported as filegroup - XR shell component wraps in xr_go_library.
"""

# Export generated Go source files as filegroup
filegroup(
    name = "slpb_srcs",
    srcs = glob(
        ["*.go"],
        exclude = ["*_test.go"],
    ),
    visibility = ["//visibility:public"],
)

# Export go.mod for dependency information
exports_files(
    ["go.mod", "go.sum"],
    visibility = ["//visibility:public"],
)

