"""
Service Layer Go Protobuf Bindings

Generated Go code from Service Layer proto files.
Exported as raw source files for consumption by XR build system.
"""

# Export all individual .go files for direct consumption
exports_files(
    glob(["*.go"], exclude = ["*_test.go"]),
    visibility = ["//visibility:public"],
)

# Export generated Go source files as a filegroup (for convenience)
filegroup(
    name = "slpb_srcs",
    srcs = glob(
        ["*.go"],
        exclude = [
            "*_test.go",
        ],
    ),
    visibility = ["//visibility:public"],
)

# Export go.mod for dependency information
exports_files(
    ["go.mod", "go.sum"],
    visibility = ["//visibility:public"],
)
