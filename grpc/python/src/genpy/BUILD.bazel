"""
Service Layer Python Protobuf Bindings

Generated Python code from Service Layer proto files.
Exported as raw source files for consumption by XR build system.
"""

# Export generated Python source files
# XR build will create py_library using its own rules_python
filegroup(
    name = "genpy_srcs",
    srcs = glob(["*.py"]),
    visibility = ["//visibility:public"],
)
